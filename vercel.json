{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run sync -- --soft && npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    { "source": "/products/:handle", "destination": "/producto/:handle", "permanent": true },
    { "source": "/collections/:collection/products/:handle", "destination": "/producto/:handle", "permanent": true },
    { "source": "/collections/all", "destination": "/tienda", "permanent": true },
    { "source": "/collections/talleres-de-velas-mi-veleria-studio", "destination": "/talleres", "permanent": true },
    { "source": "/collections/:handle", "destination": "/coleccion/:handle", "permanent": true },
    { "source": "/collections", "destination": "/tienda", "permanent": true },
    { "source": "/search", "destination": "/tienda", "permanent": true },
    { "source": "/pages/contact", "destination": "/#visitanos", "permanent": true },
    { "source": "/pages/preguntas-frecuentes", "destination": "/#preguntas", "permanent": true },
    { "source": "/pages/:page", "destination": "/", "permanent": false },
    { "source": "/cart", "destination": "/", "permanent": false },
    { "source": "/cart/:path*", "destination": "https://tienda.miveleria.com/cart/:path*", "permanent": false },
    { "source": "/account", "destination": "https://tienda.miveleria.com/account", "permanent": false },
    { "source": "/account/:path*", "destination": "https://tienda.miveleria.com/account/:path*", "permanent": false },
    { "source": "/checkouts/:path*", "destination": "https://tienda.miveleria.com/checkouts/:path*", "permanent": false },
    { "source": "/policies/:path*", "destination": "https://tienda.miveleria.com/policies/:path*", "permanent": false },
    { "source": "/blogs/:path*", "destination": "https://tienda.miveleria.com/blogs/:path*", "permanent": false }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/brand/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    }
  ]
}
