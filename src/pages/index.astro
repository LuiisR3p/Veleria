---
import Base from "../layouts/Base.astro";
import ProductCard from "../components/ProductCard.astro";
import Builder from "../components/Builder.astro";
import WaIcon from "../components/WaIcon.astro";
import {
  SITE, products, workshops, collections, getProduct, getCollection, collectionProducts,
  collectionUrl, productUrl, img, srcset, siteImg, siteSrcset, money, priceLabel, WAX_GUIDE,
} from "../lib/catalog";

const base = workshops[0];
const otherWorkshops = workshops.slice(1);

const route = [
  { verb: "Aprende", text: "Talleres presenciales para dar tus primeros pasos.", href: "/talleres", cta: "Ver talleres", file: "C81C3094-377A-447A-9F1A-10DF283119D6_3.jpg" },
  { verb: "Equípate", text: "El kit inicial, listo para tu primera vela.", href: "/coleccion/kit-para-velas", cta: "Ver el kit", file: "IMG_3658.heic" },
  { verb: "Crea", text: "Ceras, fragancias, colorantes y todo para tus creaciones.", href: "/tienda?grupo=insumos", cta: "Ver insumos", file: "IMG_3115_62b3eaf3-65b7-4602-8c40-4594ab5150bf.jpg" },
  { verb: "Perfecciona", text: "Herramientas precisas para llevar tus velas a otro nivel.", href: "/coleccion/herramientas-para-hacer-velas", cta: "Ver herramientas", file: "IMG_3676.heic" },
];

const categoryHandles = [
  ["ceras-y-parafinas-para-velas", "Ceras y parafinas"],
  ["fragancias-para-velas", "Fragancias"],
  ["moldes-para-velas-1", "Moldes"],
  ["envases-para-velas", "Envases"],
  ["colorantes-pigmentos-y-micas-para-velas", "Colorantes y micas"],
  ["pabilos-y-accesorios-para-velas-mechas", "Pabilos"],
  ["herramientas-para-hacer-velas", "Herramientas"],
  ["decorativos-para-velas-y-manualidades-flores-piedras-y-bouquet", "Decoración"],
] as const;
const categories = categoryHandles
  .map(([h, label]) => {
    const c = collections.find((x) => x.handle === h);
    return c ? { ...c, label } : null;
  })
  .filter((c): c is NonNullable<typeof c> => !!c);

const newest = products
  .filter((p) => p.available && p.images.length && p.type !== "Talleres")
  .sort((a, b) => +new Date(b.createdAt) - +new Date(a.createdAt))
  .slice(0, 8);

const velas = collectionProducts(getCollection("velas-aromaticas-mi-veleria")!).filter((p) => p.available).slice(0, 4);

const waxRows = WAX_GUIDE.map((w) => ({ ...w, p: getProduct(w.handle) })).filter((w) => w.p);

const faqs = [
  ["¿Cómo reservo un cupo para un taller?", "Compra el taller en la tienda o escríbenos por WhatsApp al 312 525 3893 y te ayudamos a reservar tu cupo en el horario que prefieras."],
  ["¿Los talleres incluyen todos los materiales?", "Sí. Cada taller incluye los materiales y herramientas necesarios para que crees tus propias piezas desde cero, en tu propio puesto de trabajo."],
  ["¿Hacen envíos a toda Colombia?", "Sí, enviamos a todo el país por transportadora. Si estás en Bogotá también puedes pedir un domiciliario y le entregamos tu pedido."],
  ["¿Puedo recoger mi pedido en la tienda?", "Claro. Elige «Recoger en tienda» al pagar y lo recoges en La Alquería, Bogotá. Normalmente está listo en 24 horas."],
  ["¿Qué incluye el Kit inicial?", "Cera de soya de alto y bajo punto de fusión, estufa eléctrica, olla para derretir, pistola de calor, termómetro, gramera, dos colorantes, una fragancia de canela y pabilo. Todo lo esencial para tu primera vela."],
  ["¿Cuál es la política de cambios y devoluciones?", "Hacemos cambios por referencia y por garantía. Puedes ver todos los detalles en nuestra política de devoluciones."],
];

const heroFile = "IMG_3047.heic";
const heroSizes = "(min-width: 1000px) 58vw, 100vw";
---
<Base preload={{ href: siteImg(heroFile, 1200), srcset: siteSrcset(heroFile), sizes: heroSizes }}>
  <!-- PORTADA -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <h1 class="hero__title display">Todo para aprender, crear y emprender con velas.</h1>
        <p class="lede">Insumos, moldes y talleres presenciales en Bogotá. Desde tu primera vela hasta tu propio emprendimiento.</p>
        <div class="hero__ctas">
          <a class="btn btn--primary" href="/tienda?grupo=insumos">Comprar insumos</a>
          <a class="btn btn--outline" href="/talleres">Ver talleres</a>
        </div>
      </div>
      <figure class="hero__media">
        <img
          src={siteImg(heroFile, 1200)}
          srcset={siteSrcset(heroFile)}
          sizes={heroSizes}
          alt="Mesa de madera con escamas de cera, fragancias, pabilos y canela"
          width="2000" height="1500" fetchpriority="high" decoding="async"
        />
        {base && (
          <a class="hero__card" href={productUrl(base)}>
            <img src={img(base.images[0]?.src, 160)} alt="" width="64" height="64" />
            <span>
              <small>Empieza aquí</small>
              <strong>{base.title}</strong>
              <span>{money(base.priceMin)} con materiales incluidos</span>
            </span>
          </a>
        )}
      </figure>
    </div>
  </section>

  <!-- RUTA -->
  <section class="route" aria-labelledby="route-title">
    <div class="wrap">
      <h2 id="route-title" class="sr-only">Tu camino en Mi Velería</h2>
      <ol class="route__list">
        {route.map((r, i) => (
          <li class="route__item">
            <a href={r.href}>
              <img src={siteImg(r.file, 600)} srcset={siteSrcset(r.file, [360, 600, 900])} sizes="(min-width: 900px) 25vw, 70vw" alt="" width="600" height="600" loading="lazy" decoding="async" />
              <span class="route__n" aria-hidden="true">{i + 1}</span>
              <span class="route__verb display">{r.verb}</span>
              <span class="route__text">{r.text}</span>
              <span class="route__cta">{r.cta}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- TALLERES -->
  <section class="section workshops" id="talleres" aria-labelledby="ws-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="ws-title" class="h-xl">Talleres presenciales en Bogotá</h2>
        <p class="muted">Grupos pequeños, tu propio puesto y tus propias herramientas. Nada de mirar desde lejos cómo trabaja otra persona.</p>
      </div>
      <div class="ws">
        {base && (
          <article class="ws__feature">
            <a class="ws__img" href={productUrl(base)} tabindex="-1" aria-hidden="true">
              <img src={img(base.images[0]?.src, 900)} srcset={srcset(base.images[0]?.src, [480, 720, 960, 1200])} sizes="(min-width: 1000px) 40vw, 100vw" alt="" width="900" height="900" loading="lazy" decoding="async" />
            </a>
            <div class="ws__body">
              <p class="ws__kicker">Para empezar desde cero</p>
              <h3 class="h-lg"><a href={productUrl(base)}>{base.title}</a></h3>
              <p class="muted">Tu primera vela tipo Ice Latte, con efecto de bebida fría. Aprendes tipos de cera, temperaturas, fragancias, colorantes y seguridad, y te llevas tu vela.</p>
              <div class="ws__buy">
                <strong>{money(base.priceMin)}</strong>
                <a class="btn btn--primary btn--sm" href={productUrl(base)}>Reservar mi cupo</a>
              </div>
            </div>
          </article>
        )}
        <ul class="ws__list">
          {otherWorkshops.map((w) => (
            <li>
              <a class="ws__row" href={productUrl(w)}>
                <img src={img(w.images[0]?.src, 200)} alt="" width="88" height="88" loading="lazy" decoding="async" />
                <span class="ws__row-t">
                  <strong>{w.title.replace(/^Taller /, "")}</strong>
                  <small>{w.needsBase ? "Requiere el Taller Base" : "No requiere experiencia"}</small>
                </span>
                <span class="ws__row-p">
                  {w.onSale && <s>{money(w.variants[0].compare!)}</s>}
                  {money(w.priceMin)}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ARMADOR -->
  <Builder />

  <!-- CATEGORÍAS -->
  <section class="section" aria-labelledby="cat-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="cat-title" class="h-xl">Insumos para cada creación</h2>
        <a class="link" href="/tienda">Ver los {products.length} productos</a>
      </div>
      <ul class="cats">
        {categories.map((c) => (
          <li class="cat">
            <a href={collectionUrl(c)}>
              <img src={img(c.image, 720)} srcset={srcset(c.image, [360, 540, 720, 960])} sizes="(min-width: 900px) 25vw, 50vw" alt="" width="720" height="720" loading="lazy" decoding="async" />
              <span class="cat__label"><strong>{c.label}</strong><small>{c.products.length} productos</small></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- GUÍA DE CERAS -->
  <section class="section waxes" id="guia-ceras" aria-labelledby="wax-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="wax-title" class="h-xl">¿Qué cera necesito?</h2>
        <p class="muted">La regla corta: cera de bajo punto de fusión para velas en vaso, de alto punto para velas de molde. Aquí están todas, con sus datos técnicos.</p>
      </div>
      <div class="wax-table" role="table" aria-label="Comparativa de ceras">
        <div class="wax-row wax-row--head" role="row">
          <span role="columnheader">Cera</span>
          <span role="columnheader">Ideal para</span>
          <span role="columnheader">Punto de fusión</span>
          <span role="columnheader">Precio</span>
        </div>
        {waxRows.map((w) => (
          <a class:list={["wax-row", { "is-out": !w.p!.available }]} role="row" href={productUrl(w.p!)}>
            <span role="cell" class="wax-name">
              {w.p!.images[0] ? <img src={img(w.p!.images[0].src, 120)} alt="" width="48" height="48" loading="lazy" decoding="async" /> : <span class="wax-noimg" aria-hidden="true"></span>}
              <span><strong>{w.p!.title}</strong><small>{w.note}</small></span>
            </span>
            <span role="cell" class="wax-use"><span class="wax-k">Ideal para </span>{w.use}</span>
            <span role="cell" class="wax-melt"><span class="wax-k">Fusión </span>{w.melt}</span>
            <span role="cell" class="wax-price">{w.p!.available ? priceLabel(w.p!) : "Agotada"}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- NOVEDADES -->
  <section class="section" aria-labelledby="new-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="new-title" class="h-xl">Recién llegados al taller</h2>
        <a class="link" href="/tienda?orden=nuevos">Ver todas las novedades</a>
      </div>
      <ul class="grid-products">
        {newest.map((p) => <li><ProductCard p={p} /></li>)}
      </ul>
    </div>
  </section>

  <!-- VELAS HECHAS -->
  {velas.length > 0 && (
    <section class="section made" aria-labelledby="made-title">
      <div class="wrap made__grid">
        <div class="made__copy">
          <h2 id="made-title" class="h-xl">¿Prefieres regalar una ya hecha?</h2>
          <p class="muted">Velas decorativas y aromáticas hechas en nuestro Studio, con las mismas técnicas que enseñamos en los talleres.</p>
          <a class="btn btn--outline" href="/coleccion/velas-aromaticas-mi-veleria">Ver velas Mi Velería</a>
        </div>
        <ul class="grid-products made__list">
          {velas.map((p) => <li><ProductCard p={p} sizes="(min-width: 1000px) 18vw, 46vw" /></li>)}
        </ul>
      </div>
    </section>
  )}

  <!-- NOSOTROS -->
  <section class="about" id="nosotros" aria-labelledby="about-title">
    <div class="wrap about__grid">
      <figure class="about__media">
        <img src={siteImg("3CEA80D0-47B7-43A6-BC76-3BB52B147B93.jpg", 1200)} srcset={siteSrcset("3CEA80D0-47B7-43A6-BC76-3BB52B147B93.jpg", [600, 900, 1200, 1600])} sizes="(min-width: 900px) 50vw, 100vw" alt="Mesas de trabajo del Studio con un puesto completo para cada alumna" width="1200" height="900" loading="lazy" decoding="async" />
      </figure>
      <div class="about__copy">
        <h2 id="about-title" class="h-xl">Una pasión que se nos fue de las manos, en el buen sentido.</h2>
        <div class="prose">
          <p>Vimos que el mundo de las velas estaba creciendo en Bogotá y soñamos con un lugar donde esa pasión se pudiera compartir de verdad, no solo enseñar de afán.</p>
          <p>Desde febrero de 2026 abrimos los talleres presenciales, pensados para que cada persona tenga su propio espacio, sus propias herramientas y toda nuestra atención. Aquí creas con tus manos, acompañada de cerca.</p>
          <p>Para que ese resultado sea siempre especial, escogemos con cariño cada insumo que vendemos: ceras, fragancias y colorantes que de verdad valen la pena.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PREGUNTAS + VISÍTANOS -->
  <section class="section" aria-label="Ayuda">
    <div class="wrap help">
      <div id="preguntas">
        <h2 class="h-xl">Preguntas frecuentes</h2>
        <div class="faq">
          {faqs.map(([q, a]) => (
            <details>
              <summary>{q}</summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
      </div>
      <aside class="visit" id="visitanos" aria-labelledby="visit-title">
        <h2 id="visit-title" class="h-lg">Visítanos en el Studio</h2>
        <address>Mi Velería Studio<br />{SITE.address}</address>
        <p class="muted">Compra en línea y elige recoger en tienda, o ven a conocer el taller.</p>
        <div class="visit__ctas">
          <a class="btn btn--primary" href={`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent("Hola Mi Velería, tengo una pregunta:")}`} target="_blank" rel="noopener"><WaIcon /> Escribir por WhatsApp</a>
          <a class="btn btn--outline" href={SITE.mapsUrl} target="_blank" rel="noopener">Cómo llegar</a>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  /* Portada */
  .hero { padding-block: clamp(28px, 5vw, 64px) clamp(40px, 6vw, 80px); }
  .hero__grid { display: grid; gap: 32px; align-items: center; }
  @media (min-width: 1000px) { .hero__grid { grid-template-columns: 5fr 7fr; gap: 56px; } }
  .hero__title { font-size: var(--t-3xl); line-height: 1.02; letter-spacing: -.02em; max-width: 13ch; }
  .hero__copy .lede { margin-top: 20px; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .hero__media { position: relative; }
  .hero__media > img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--r-lg); background: var(--roble-claro); }
  .hero__card {
    position: absolute; left: 16px; bottom: 16px; right: 16px; max-width: 360px;
    display: flex; gap: 12px; align-items: center; padding: 10px 16px 10px 10px;
    background: rgba(251, 248, 244, .95); backdrop-filter: blur(8px); border-radius: var(--r-md);
    text-decoration: none; box-shadow: 0 16px 40px -20px rgba(51, 32, 28, .5);
  }
  .hero__card img { width: 64px; height: 64px; border-radius: 10px; object-fit: cover; flex: none; }
  .hero__card > span { display: grid; line-height: 1.3; font-size: var(--t-sm); }
  .hero__card small { color: var(--canela); font-weight: 600; }
  .hero__card strong { font-size: var(--t-md); }
  .hero__card:hover strong { text-decoration: underline; }

  /* Ruta */
  .route { padding-bottom: clamp(48px, 7vw, 96px); }
  .route__list { list-style: none; padding: 0; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(240px, 72%); gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; margin-inline: calc(-1 * var(--gutter)); padding-inline: var(--gutter); }
  .route__list::-webkit-scrollbar { display: none; }
  @media (min-width: 900px) { .route__list { grid-auto-flow: row; grid-template-columns: repeat(4, 1fr); overflow: visible; margin: 0; padding: 0; gap: 20px; } }
  .route__item { scroll-snap-align: start; }
  .route__item a { position: relative; display: grid; gap: 6px; text-decoration: none; }
  .route__item img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: var(--r-md); margin-bottom: 10px; background: var(--roble-claro); }
  .route__n { position: absolute; top: 12px; left: 12px; width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; background: var(--cera); font-family: var(--display); font-size: var(--t-sm); }
  .route__verb { font-size: var(--t-xl); }
  .route__text { color: var(--tinta-suave); font-size: var(--t-sm); max-width: 32ch; }
  .route__cta { font-weight: 600; color: var(--canela); font-size: var(--t-sm); text-decoration: underline; text-underline-offset: 3px; }

  /* Talleres */
  .workshops { background: var(--arena); }
  .ws { display: grid; gap: 28px; }
  @media (min-width: 1000px) { .ws { grid-template-columns: 1.05fr 1fr; gap: 48px; align-items: start; } }
  .ws__feature { display: grid; gap: 20px; }
  .ws__img img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--r-lg); }
  .ws__body { display: grid; gap: 10px; }
  .ws__body h3 a { text-decoration: none; }
  .ws__body h3 a:hover { text-decoration: underline; }
  .ws__kicker { color: var(--canela); font-weight: 600; font-size: var(--t-sm); }
  .ws__buy { display: flex; align-items: center; gap: 20px; margin-top: 8px; }
  .ws__buy strong { font-size: var(--t-xl); font-family: var(--display); }
  .ws__list { list-style: none; padding: 0; border-top: 1px solid var(--linea-fuerte); }
  .ws__list li { border-bottom: 1px solid var(--linea-fuerte); }
  .ws__row { display: grid; grid-template-columns: 72px 1fr auto; gap: 16px; align-items: center; padding: 14px 4px; text-decoration: none; transition: background-color .15s; border-radius: var(--r-sm); }
  .ws__row:hover { background: rgba(255, 255, 255, .5); }
  .ws__row img { width: 72px; height: 72px; border-radius: 12px; object-fit: cover; }
  .ws__row-t { display: grid; line-height: 1.3; }
  .ws__row-t strong { font-size: var(--t-md); }
  .ws__row-t small { color: var(--tinta-suave); font-size: var(--t-sm); }
  .ws__row-p { display: grid; justify-items: end; font-weight: 700; }
  .ws__row-p s { font-weight: 400; font-size: var(--t-xs); color: var(--tinta-suave); }

  /* Categorías */
  .cats { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
  @media (min-width: 900px) { .cats { grid-template-columns: repeat(4, 1fr); gap: 16px; } }
  .cat a { position: relative; display: block; border-radius: var(--r-md); overflow: hidden; aspect-ratio: 1; text-decoration: none; background: var(--roble-claro); }
  .cat img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease); }
  .cat a:hover img { transform: scale(1.04); }
  .cat__label { position: absolute; left: 10px; bottom: 10px; right: 10px; display: grid; padding: 10px 14px; border-radius: 12px; background: rgba(251, 248, 244, .94); line-height: 1.25; }
  .cat__label strong { font-size: var(--t-md); }
  .cat__label small { color: var(--tinta-suave); font-size: var(--t-xs); }

  /* Guía de ceras */
  .waxes { background: var(--cera); border-top: 1px solid var(--linea); }
  .wax-table { display: grid; border-top: 1.5px solid var(--cacao); }
  .wax-row { display: grid; grid-template-columns: 1fr auto; gap: 4px 16px; padding: 16px 4px; border-bottom: 1px solid var(--linea); text-decoration: none; align-items: center; }
  .wax-row:not(.wax-row--head):hover { background: var(--arena); }
  .wax-row--head { display: none; }
  .wax-name { display: flex; gap: 14px; align-items: center; grid-column: 1 / -1; }
  .wax-noimg { width: 48px; height: 48px; border-radius: 10px; flex: none; background: linear-gradient(135deg, var(--arena), var(--roble-claro)); }
  .wax-name img { width: 48px; height: 48px; border-radius: 10px; object-fit: cover; flex: none; background: var(--arena); }
  .wax-name > span { display: grid; line-height: 1.35; }
  .wax-name small { color: var(--tinta-suave); font-size: var(--t-sm); }
  .wax-use, .wax-melt { font-size: var(--t-sm); padding-left: 62px; }
  .wax-melt { grid-column: 1; }
  .wax-price { grid-column: 2; grid-row: 2 / span 2; font-weight: 700; text-align: right; }
  .wax-k { color: var(--tinta-suave); }
  .wax-row.is-out { opacity: .6; }
  @media (min-width: 900px) {
    .wax-row { grid-template-columns: minmax(0, 2.3fr) 1.2fr .8fr .8fr; gap: 24px; }
    .wax-row--head { display: grid; font-size: var(--t-xs); font-weight: 600; color: var(--tinta-suave); padding-block: 12px; }
    .wax-name { grid-column: auto; }
    .wax-use, .wax-melt { padding-left: 0; grid-column: auto; font-size: var(--t-md); }
    .wax-melt { font-variant-numeric: tabular-nums; }
    .wax-price { grid-column: auto; grid-row: auto; }
    .wax-k { display: none; }
  }

  /* Velas hechas */
  .made { background: var(--petalo); }
  .made__grid { display: grid; gap: 32px; }
  @media (min-width: 1000px) { .made__grid { grid-template-columns: 320px 1fr; gap: 56px; align-items: center; } }
  .made__copy { display: grid; gap: 16px; justify-items: start; }
  @media (min-width: 1100px) { .made__list { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .made :global(.pcard__media) { background: rgba(255, 255, 255, .5); }

  /* Nosotros */
  .about { background: var(--cacao); color: #F3E8DF; padding-block: clamp(64px, 9vw, 120px); }
  .about__grid { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 900px) { .about__grid { grid-template-columns: 1fr 1fr; gap: 64px; } }
  .about__media img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--r-lg); }
  .about__copy { display: grid; gap: 24px; }
  .about .prose { color: #D8C6BA; }

