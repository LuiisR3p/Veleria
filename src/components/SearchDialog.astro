<dialog class="search" data-search aria-label="Buscar productos">
  <form class="search__form" method="get" action="/tienda" role="search">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
    <label class="sr-only" for="q">Buscar</label>
    <input id="q" name="q" type="search" placeholder="Busca cera de soya, molde de rosa, fragancia vainilla…" autocomplete="off" data-search-input />
    <button class="search__close" type="button" data-close-search>Cerrar</button>
  </form>
  <p class="search__status muted" data-search-status>Escribe al menos 2 letras.</p>
  <ul class="search__results" data-search-results></ul>
  <div class="search__suggest" data-search-suggest>
    <p class="muted">Lo más buscado</p>
    <div class="search__chips">
      <a class="chip" href="/coleccion/ceras-y-parafinas-para-velas">Cera de soya</a>
      <a class="chip" href="/coleccion/fragancias-premium">Fragancias premium</a>
      <a class="chip" href="/coleccion/moldes-de-flores">Moldes de flores</a>
      <a class="chip" href="/coleccion/kit-para-velas">Kit inicial</a>
      <a class="chip" href="/talleres">Talleres</a>
    </div>
  </div>
</dialog>

<style>
  .search {
    width: min(100% - 24px, 720px); max-height: min(80vh, 680px); margin: 10vh auto auto; padding: 0;
    border: 0; border-radius: var(--r-lg); background: var(--cera); color: var(--cacao);
    box-shadow: 0 40px 80px -30px rgba(51, 32, 28, .55);
  }
  .search::backdrop { background: rgba(51, 32, 28, .45); }
  .search__form { display: flex; align-items: center; gap: 12px; padding: 14px 16px 14px 20px; border-bottom: 1px solid var(--linea); }
  .search__form svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; flex: none; }
  .search__form input { flex: 1; min-width: 0; border: 0; background: none; font-size: 1.1rem; padding: 10px 0; outline: none; }
  .search__close { border: 0; background: var(--arena); border-radius: 999px; padding: 8px 14px; font-size: var(--t-sm); font-weight: 600; cursor: pointer; }
  .search__status { padding: 14px 20px 0; font-size: var(--t-sm); }
  .search__results { list-style: none; padding: 8px 12px 16px; overflow-y: auto; max-height: 58vh; }
  .search__results:empty { display: none; }
  .search__suggest { padding: 16px 20px 24px; display: grid; gap: 10px; }
  .search__suggest[hidden] { display: none; }
  .search__chips { display: flex; flex-wrap: wrap; gap: 8px; }
  :global(.sres) { display: flex; align-items: center; gap: 14px; padding: 8px; border-radius: var(--r-sm); text-decoration: none; }
  :global(.sres:hover), :global(.sres:focus-visible) { background: var(--arena); }
  :global(.sres img) { width: 52px; height: 52px; border-radius: 10px; object-fit: cover; background: var(--arena); flex: none; }
  :global(.sres span) { display: grid; line-height: 1.3; }
  :global(.sres__noimg) { width: 52px; height: 52px; border-radius: 10px; flex: none; background: var(--arena); }
  :global(.sres small) { color: var(--tinta-suave); }
</style>
