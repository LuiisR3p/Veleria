---
import WaIcon from "./WaIcon.astro";
import { SITE, money } from "../lib/catalog";
---
<div class="drawer" id="cart" data-cart hidden>
  <div class="drawer__scrim" data-close-cart></div>
  <div class="drawer__panel cart" role="dialog" aria-modal="true" aria-labelledby="cart-title">
    <div class="drawer__head">
      <h2 id="cart-title" class="h-lg">Tu carrito</h2>
      <button class="icon-btn" type="button" data-close-cart>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
        <span class="sr-only">Cerrar carrito</span>
      </button>
    </div>

    <div class="cart__ship" data-ship data-free-from={SITE.freeShippingFrom}>
      <p data-ship-text>Te faltan {money(SITE.freeShippingFrom)} para el envío gratis.</p>
      <div class="cart__bar" aria-hidden="true"><span data-ship-bar></span></div>
    </div>

    <ul class="cart__items" data-cart-items></ul>

    <div class="cart__empty" data-cart-empty>
      <p class="h-lg">Tu carrito está vacío</p>
      <p class="muted">Empieza por la cera, el corazón de cualquier vela.</p>
      <a class="btn btn--outline" href="/coleccion/ceras-y-parafinas-para-velas">Ver ceras</a>
    </div>

    <div class="cart__foot" data-cart-foot hidden>
      <p class="cart__total"><span>Subtotal</span><strong data-cart-total>$0</strong></p>
      <p class="cart__fine">El envío y los descuentos se calculan al pagar. Puedes elegir recoger en tienda.</p>
      <a class="btn btn--primary btn--block" data-checkout href="#">Ir a pagar</a>
      <a class="btn btn--outline btn--block" data-wa-order href="#" target="_blank" rel="noopener"><WaIcon /> Pedir por WhatsApp</a>
    </div>
  </div>
</div>

<template id="cart-item-tpl">
  <li class="citem">
    <img class="citem__img" alt="" width="72" height="72" />
    <div class="citem__body">
      <a class="citem__title"></a>
      <p class="citem__variant muted"></p>
      <div class="citem__row">
        <div class="qty">
          <button type="button" data-dec aria-label="Quitar uno">−</button>
          <span data-qty></span>
          <button type="button" data-inc aria-label="Agregar uno">+</button>
        </div>
        <strong class="citem__price"></strong>
      </div>
    </div>
    <button class="citem__remove" type="button" data-remove>Quitar</button>
  </li>
</template>

<style>
  .cart { gap: 0; padding: 0; }
  .cart .drawer__head { padding: 16px 20px; border-bottom: 1px solid var(--linea); }
  .cart__ship { padding: 14px 20px; background: var(--arena); font-size: var(--t-sm); display: grid; gap: 8px; }
  .cart__bar { height: 6px; border-radius: 999px; background: var(--roble-claro); overflow: hidden; }
  .cart__bar span { display: block; height: 100%; width: 0; background: var(--canela); border-radius: inherit; transition: width .4s var(--ease); }
  .cart__items { list-style: none; padding: 4px 20px; flex: 1; overflow-y: auto; }
  .cart__empty { flex: 1; display: grid; align-content: center; justify-items: center; gap: 10px; text-align: center; padding: 40px 24px; }
  .cart__empty[hidden] { display: none; }
  .cart__foot { padding: 18px 20px 24px; border-top: 1px solid var(--linea); display: grid; gap: 10px; }
  .cart__foot[hidden] { display: none; }
  .cart__total { display: flex; justify-content: space-between; align-items: baseline; font-size: var(--t-lg); }
  .cart__total strong { font-size: 1.5rem; }
  .cart__fine { font-size: var(--t-xs); color: var(--tinta-suave); margin-bottom: 4px; }

  :global(.citem) { position: relative; display: grid; grid-template-columns: 72px 1fr; gap: 14px; padding: 16px 0; border-bottom: 1px solid var(--linea); }
  :global(.citem__img) { width: 72px; height: 72px; border-radius: 10px; object-fit: cover; background: var(--arena); }
  :global(.citem__body) { display: grid; gap: 2px; min-width: 0; padding-right: 48px; }
  :global(.citem__title) { font-weight: 600; text-decoration: none; line-height: 1.3; }
  :global(.citem__variant) { font-size: var(--t-sm); }
  :global(.citem__row) { display: flex; align-items: center; justify-content: space-between; margin-top: 8px; }
  :global(.citem__remove) { position: absolute; top: 14px; right: 0; border: 0; background: none; font-size: var(--t-xs); color: var(--tinta-suave); text-decoration: underline; cursor: pointer; padding: 4px; }
  :global(.qty) { display: inline-flex; align-items: center; border: 1.5px solid var(--linea-fuerte); border-radius: 999px; height: 40px; }
  :global(.qty button) { width: 38px; height: 100%; border: 0; background: none; font-size: 1.15rem; cursor: pointer; border-radius: 999px; }
  :global(.qty button:hover) { background: var(--arena); }
  :global(.qty span), :global(.qty input) { min-width: 28px; width: 36px; text-align: center; font-weight: 600; font-variant-numeric: tabular-nums; border: 0; background: none; padding: 0; }
</style>
