---
/* Logo oficial de Mi Velería Studio, extraído de su arte original
   (fondo transparente). "dark" para fondos claros, "light" para fondos oscuros. */
const { tone = "dark" } = Astro.props as { tone?: "dark" | "light" };
const src = tone === "dark" ? "/brand/mi-veleria-logo.png" : "/brand/mi-veleria-logo-claro.png";
const [w, h] = tone === "dark" ? [322, 192] : [496, 360];
---
<img class:list={["logo", `logo--${tone}`]} src={src} width={w} height={h} alt="Mi Velería Studio" decoding="async" />

<style>
  .logo { display: block; width: auto; }
  .logo--dark { height: 52px; }
  .logo--light { height: 150px; }
  @media (min-width: 720px) { .logo--dark { height: 60px; } }
</style>
