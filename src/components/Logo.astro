---
const { tone = "dark" } = Astro.props as { tone?: "dark" | "light" };
---
<span class:list={["logo", `logo--${tone}`]}>
  <svg class="logo__flame" viewBox="0 0 32 40" aria-hidden="true">
    <path d="M16 3c3.5 6.2 9 10.4 9 18a9 9 0 0 1-18 0c0-4.6 2.3-7.5 4.4-10.2.4 3 1.6 5 3.6 6.2C13.6 12.5 14.4 7.6 16 3Z" fill="currentColor"/>
    <g stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity=".7">
      <path d="M3 13l3 1.6M29 13l-3 1.6M5 5.5l3 3M27 5.5l-3 3"/>
    </g>
  </svg>
  <span class="logo__text">
    <span class="logo__name">Mi Velería</span>
    <span class="logo__sub">Studio</span>
  </span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; line-height: 1; }
  .logo__flame { width: 22px; height: 28px; color: var(--oro); flex: none; }
  .logo__text { display: grid; gap: 3px; }
  .logo__name { font-family: var(--display); font-size: 1.45rem; letter-spacing: -.01em; }
  .logo__sub { font-size: .66rem; font-weight: 600; letter-spacing: .32em; text-transform: uppercase; opacity: .7; padding-left: 2px; }
  .logo--light { color: var(--cera); }
</style>
